<launch>

    <!-- rosbag controls -->
    <arg name="sim_time_required" default="true"/>
    <param name="use_sim_time" value="$(arg sim_time_required)"/>
    <!-- general configuration -->
    <arg name="dataset_name" default="realsense" doc="Dataset name (used for parsing config)"/>
    <arg name="ablation_name" default="realsense_fine" doc="Ablation name (used for parsing config)"/>
    <arg name="segmenter_config" default="$(find clio_ros)/config/segmentation/house_clip.yaml" doc="openset segmentation config to use"/>
    <!-- tf frames -->
    <arg name="map_frame" default="odom"/>
    <arg name="odom_frame" default="odom"/>
    <arg name="robot_frame" default="base_link"/>
    <arg name="sensor_frame" default="camera_link_optical"/>

    <!-- Takes rgb data and resizes it-->
    <node name="image_resize" pkg="nodelet" type="nodelet"
        args="standalone image_proc/resize">
        <remap from="image" to="/camera/realsense_d435/image_raw"/>
        <remap from="image/resize" to="/camera/realsense_d435/image_raw_small"/>
        <param name="width" value="640"/>
        <param name="height" value="480"/>
    </node>
    <!-- takes resized data and reduces fps-->
    <node pkg="topic_tools"
      type="throttle"
      name="image_throttle"
      args="messages /image_resize/image 6.0 /camera/image_throttled_throttle" 
    />

    <arg name="run_segmentation" default="true"/>
    <group if="$(arg run_segmentation)">
        <remap from="semantic_inference/color/image_raw" to="/camera/image_throttled_throttle"/>
        <remap from="semantic_inference/semantic/image_raw" to="/realsense_d435/semantic/image_raw"/>
        <remap from="semantic_inference/semantic/feature" to="/realsense_d435/semantic/clip_vector"/>
        <include file="$(find semantic_inference_ros)/launch/openset_segmentation.launch">
            <arg name="config_path" value="$(arg segmenter_config)"/>
        </include>
    </group>

    <group unless="$(arg run_segmentation)">
        <node pkg="semantic_inference_ros" type="language_embedding_node" name="semantic_inference">
            <rosparam file="$(arg segmenter_config)"/> <!-- sets model name -->
        </node>
    </group>

    <arg name="run_clio" default="true"/>
    <group if="$(arg run_clio)">
        <!-- TODO(nathan) change topic -->
        <remap from="/clio_node/input/camera/rgb/image_raw" to="/camera/image_throttled_throttle"/>
        <remap from="/clio_node/input/camera/depth_registered/image_rect" to="/camera/realsense_d435/depth/image_raw"/>
        <remap from="/clio_node/input/camera/semantic/image_raw" to="/realsense_d435/semantic/image_raw"/>
        <remap from="/clio_node/input/camera/feature" to="/realsense_d435/semantic/clip_vector"/>
        <include file="$(find clio_ros)/launch/clio.launch" pass_all_args="true">
            <arg name="sensor_min_range" default="0.3" doc="minimum sensor range in meters"/>
            <arg name="sensor_max_range" default="5.0" doc="maximum sensor range in meters"/>
        </include>
    </group>

</launch>
